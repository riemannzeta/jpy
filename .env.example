# Japanese Market Stress Dashboard - Environment Variables

# Alpha Vantage API Key (Required for live FX historical data and enhanced features)
# Get free API key at: https://www.alphavantage.co/support/#api-key
# Free tier: 500 requests/day, 5 requests/minute
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# FRED API Key (Optional but recommended for live JGB and Treasury yield data)
# Get free API key at: https://fredaccount.stlouisfed.org/apikeys
# Free tier: No rate limits for reasonable use
FRED_API_KEY=your_fred_api_key_here

# Node environment
NODE_ENV=development
